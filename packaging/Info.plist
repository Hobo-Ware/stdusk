<?xml version="1.0" encoding="UTF-8"?>
<!-- stdusk.app bundle metadata. The release workflow substitutes __VERSION__. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleName</key>
    <string>stdusk</string>
    <key>CFBundleDisplayName</key>
    <string>stdusk</string>
    <key>CFBundleIdentifier</key>
    <string>dev.hoboware.stdusk</string>
    <key>CFBundleExecutable</key>
    <string>stdusk</string>
    <key>CFBundleIconFile</key>
    <string>stdusk</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>__VERSION__</string>
    <key>CFBundleVersion</key>
    <string>__VERSION__</string>
    <key>LSMinimumSystemVersion</key>
    <string>11.0</string>
    <key>NSHighResolutionCapable</key>
    <true/>
    <key>LSApplicationCategoryType</key>
    <string>public.app-category.developer-tools</string>
    <!-- TCC prompts fire for the shell stdusk hosts, not for stdusk itself; without these
         strings macOS shows a bare, unexplained dialog. -->
    <key>NSDesktopFolderUsageDescription</key>
    <string>stdusk runs your shell - commands you run, including tab-completion, may read or write files on your Desktop.</string>
    <key>NSDocumentsFolderUsageDescription</key>
    <string>stdusk runs your shell - commands you run, including tab-completion, may read or write files in your Documents folder.</string>
    <key>NSDownloadsFolderUsageDescription</key>
    <string>stdusk runs your shell - commands you run, including tab-completion, may read or write files in your Downloads folder.</string>
    <key>NSPhotoLibraryUsageDescription</key>
    <string>stdusk runs your shell - commands you run may read or write files inside your photo library.</string>
    <key>NSAppleMusicUsageDescription</key>
    <string>stdusk runs your shell - commands you run may read or write files inside your media library.</string>
    <key>NSAppDataUsageDescription</key>
    <string>stdusk runs your shell - commands you run may read or write files inside other apps' data containers.</string>
</dict>
</plist>
